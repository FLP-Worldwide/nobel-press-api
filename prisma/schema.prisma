generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  password  String
  verified  Boolean  @default(false)
  role      Role     @default(buyer)
  books     Book[]
  createdAt DateTime @default(now())
}

enum Role {
  author
  buyer
  admin
}

enum BookStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  INACTIVE
}
model Book {
  id            Int       @id @default(autoincrement())
  userId        Int
  title         String
  language      String
  authorName    String
  subheading    String?
  coAuthor      String?
  genre         String?
  status        BookStatus @default(DRAFT)
  chapters      BookChapter[]
  createdAt     DateTime   @default(now())

  // ✅ add both @default(now()) and @updatedAt
  updatedAt     DateTime   @default(now()) @updatedAt

  // covers (optional)
  frontCoverKey String?
  backCoverKey  String?
  frontCoverUrl String?
  backCoverUrl  String?

  user          User       @relation(fields: [userId], references: [id])
  design        BookDesign?
}


model BookChapter {
  id          Int       @id @default(autoincrement())
  bookId      Int
  title       String
  type        ChapterType
  content     String
  createdAt   DateTime  @default(now())

  book        Book      @relation(fields: [bookId], references: [id])
}

enum ChapterType {
  chapter
  intro
  preface
}

/* =========================
   Book Design enums + model
   ========================= */

enum BookSize {
  FIVE_X_EIGHT
  FIVE_HALF_X_EIGHT_HALF
  SIX_X_NINE
  EIGHT_HALF_X_EIGHT_HALF
  EIGHT_HALF_X_ELEVEN
  CUSTOM
}

enum BindingType {
  PAPERBACK
  HARDCOVER
}

enum BookInterior {
  BLACK_WHITE
  COLOR
}

enum PaperType {
  CREAM
  WHITE
  ART_MATTE
}

enum CoverLamination {
  MATTE
  GLOSS
  NONE
}

model BookDesign {
  id               Int            @id @default(autoincrement())
  bookId           Int            @unique

  size             BookSize
  bindingType      BindingType
  interior         BookInterior
  paperType        PaperType
  coverLamination  CoverLamination

  // For CUSTOM size (inches)
  customWidthIn    Decimal?       @db.Decimal(5,2)
  customHeightIn   Decimal?       @db.Decimal(5,2)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  book             Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

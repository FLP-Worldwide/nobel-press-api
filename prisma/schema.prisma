generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================
 * Enums (existing + new)
 * =========================
 */

enum Role {
  author
  buyer
  admin
}

enum BookStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PAYMENT_PENDING
  PUBLISHED
  REJECTED
  INACTIVE
}

enum BookReviewStatus {
  PAYMENT_PENDING
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum PublishingFeeStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ChapterType {
  section
  chapter
  intro
  preface
}

/**
 * --- New simple enums for orders & payments ---
 */
enum OrderStatus {
  PENDING
  PAID
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderKind {
  RETAIL
  AUTHOR_COPY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  CARD
  UPI
  PAYPAL
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

/**
 * =========================
 * Core Models
 * =========================
 */

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  password  String
  verified  Boolean  @default(false)
  role      Role     @default(author)
  books     Book[]
  createdAt DateTime @default(now())

  // New relations
  cart             Cart?
  orders           Order[]
  payments         Payment[]
  submittedReviews BookReview[]        @relation("ReviewSubmitter")
  reviewedReviews  BookReview[]        @relation("ReviewReviewer")
  publishingFees   PublishingPayment[]
  statusEvents     BookStatusEvent[]   @relation("BookStatusActor")
}

model Book {
  id              Int           @id @default(autoincrement())
  publicId        String        @unique @default(uuid()) @db.Uuid
  userId          Int
  title           String
  titleRoman      String?       @db.VarChar(200)
  authorNameRoman String?       @db.VarChar(160)
  language        String
  authorName      String
  subheading      String?
  coAuthor        String?
  genre           String?
  description     String?       @db.Text
  authorBiography String?       @db.Text
  copyrightHolder String?       @db.VarChar(160)
  copyrightYear   Int?
  copyrightNotice String?       @db.Text
  categories      Json?
  keywords        Json?
  termsAcceptedAt DateTime?
  pageCount       Int?
  printCost       Decimal?      @db.Decimal(12, 2)
  retailPrice     Decimal?      @db.Decimal(12, 2)
  currency        String        @default("INR")
  status          BookStatus    @default(DRAFT)
  chapters        BookChapter[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  submittedAt     DateTime?
  approvedAt      DateTime?
  publishedAt     DateTime?

  // covers (optional)
  frontCoverKey String?
  backCoverKey  String?
  frontCoverUrl String?
  backCoverUrl  String?
  coverDesign   Json?

  deletedAt DateTime?
  deletedBy Int?

  user User @relation(fields: [userId], references: [id])

  // New relations
  cartItems      CartItem[]
  orderItems     OrderItem[]
  design         BookDesign?
  revisions      BookRevision[]
  reviews        BookReview[]
  publishingFees PublishingPayment[]
  statusEvents   BookStatusEvent[]
}

model BookChapter {
  id        Int         @id @default(autoincrement())
  bookId    Int
  title     String
  type      ChapterType
  content   String      @db.Text
  position  Int         @default(0)
  creationKey String?   @db.VarChar(128)
  creationHash String?  @db.VarChar(64)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  book Book @relation(fields: [bookId], references: [id])

  @@unique([bookId, creationKey])
}

/**
 * Immutable snapshots used by reviewers and by the eventual print pipeline.
 */
model BookRevision {
  id          Int      @id @default(autoincrement())
  bookId      Int
  version     Int
  snapshot    Json
  contentHash String   @db.VarChar(64)
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())

  book           Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  review         BookReview?
  publishingFees PublishingPayment[]

  @@unique([bookId, version])
  @@index([bookId])
}

model BookReview {
  id            Int              @id @default(autoincrement())
  bookId        Int
  revisionId    Int              @unique
  status        BookReviewStatus @default(SUBMITTED)
  authorMessage String?          @db.Text
  reviewerNotes String?          @db.Text
  submittedById Int
  reviewedById  Int?
  submittedAt   DateTime         @default(now())
  reviewedAt    DateTime?

  book        Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  revision    BookRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  submittedBy User         @relation("ReviewSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?        @relation("ReviewReviewer", fields: [reviewedById], references: [id])

  @@index([bookId, submittedAt])
  @@index([status, submittedAt])
}

model PublishingPayment {
  id              Int                 @id @default(autoincrement())
  bookId          Int
  revisionId      Int
  userId          Int
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("INR")
  status          PublishingFeeStatus @default(PENDING)
  provider        String?
  redirectUrl     String?
  initiationStartedAt DateTime?
  providerOrderId String?             @unique
  providerRef     String?             @unique
  errorMessage    String?             @db.Text
  paidAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  book     Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  revision BookRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  user     User         @relation(fields: [userId], references: [id])

  @@index([bookId, status])
  @@index([userId])
}

model BookStatusEvent {
  id             Int        @id @default(autoincrement())
  bookId         Int
  actorId        Int
  previousStatus BookStatus
  newStatus      BookStatus
  notes          String?    @db.Text
  createdAt      DateTime   @default(now())

  book  Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  actor User @relation("BookStatusActor", fields: [actorId], references: [id])

  @@index([bookId, createdAt])
}

/**
 * =========================
 * Book Design
 * =========================
 */

enum BookSize {
  FIVE_X_EIGHT
  FIVE_HALF_X_EIGHT_HALF
  SIX_X_NINE
  EIGHT_HALF_X_EIGHT_HALF
  EIGHT_HALF_X_ELEVEN
  CUSTOM
}

enum BindingType {
  PAPERBACK
  HARDCOVER
}

enum BookInterior {
  BLACK_WHITE
  COLOR
}

enum PaperType {
  CREAM
  WHITE
  ART_MATTE
}

enum CoverLamination {
  MATTE
  GLOSS
  NONE
}

model BookDesign {
  id              Int             @id @default(autoincrement())
  bookId          Int             @unique
  size            BookSize
  bindingType     BindingType
  interior        BookInterior
  paperType       PaperType
  coverLamination CoverLamination

  layoutStyle     String?         @db.VarChar(40)

  // For CUSTOM size (inches)
  customWidthIn  Decimal? @db.Decimal(5, 2)
  customHeightIn Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

/**
 * =========================
 * Cart (simple)
 * =========================
 */

model Cart {
  id Int @id @default(autoincrement())

  // Either userId (for logged-in) OR sessionId (for guest)
  userId    Int?    @unique
  sessionId String? @unique

  totalPrice Decimal  @default(0) @db.Decimal(12, 2)
  totalQty   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  bookId    Int
  price     Decimal  @db.Decimal(12, 2) // unit price at add time
  qty       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id])

  @@unique([cartId, bookId]) // one row per book per cart
  @@index([bookId])
}

/**
 * =========================
 * Order (UI aligned)
 * =========================
 */

model Order {
  id     Int       @id @default(autoincrement())
  userId Int
  kind   OrderKind @default(RETAIL)
  checkoutKey String? @unique
  currency String @default("INR")
  trackingNumber String?
  trackingUrl String?
  carrier String?

  // Order Summary snapshot
  subtotal       Decimal @db.Decimal(12, 2)
  savings        Decimal @default(0) @db.Decimal(12, 2) // UI: savings
  storePickup    Decimal @default(0) @db.Decimal(12, 2) // UI: store pickup
  shippingCharge Decimal @default(0) @db.Decimal(12, 2)
  tax            Decimal @default(0) @db.Decimal(12, 2)
  totalPrice     Decimal @db.Decimal(12, 2)
  totalQty       Int

  status         OrderStatus    @default(PENDING)
  paymentMethod  PaymentMethod
  shippingMethod ShippingMethod

  // Delivery snapshot (user may edit at checkout)
  customerName  String
  customerEmail String
  customerPhone String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String
  country       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  bookId    Int
  revisionId Int?
  revision BookRevision? @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  title String?
  printCost Decimal? @db.Decimal(12, 2)
  platformCommission Decimal? @db.Decimal(12, 2)
  authorEarnings Decimal? @db.Decimal(12, 2)
  cartItemId Int?
  cartItemUpdatedAt DateTime?
  unitPrice Decimal  @db.Decimal(12, 2)
  qty       Int
  lineTotal Decimal  @db.Decimal(12, 2) // unitPrice * qty
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id])

  @@index([orderId])
  @@index([bookId])
}

/**
 * =========================
 * Payment (simple)
 * =========================
 */

model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int
  userId          Int
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  // optional gateway refs (keep simple)
  provider        String?
  currency        String @default("INR")
  redirectUrl     String?
  initiationStartedAt DateTime?
  providerRef     String? @unique // transaction id
  providerOrderId String? @unique
  errorMessage    String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

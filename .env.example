PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nobel_db"
# Vercel's existing integration supplies nobel_book_api_DATABASE_URL automatically.
# Optional direct connection for migrations if DATABASE_URL uses a pooler:
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/nobel_db?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"

# Trusted one-time admin provisioning; server-side only, never NEXT_PUBLIC_*.
# Setting these in Vercel alone does not create or update an account.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-admin-password"

AWS_REGION=your-aws-region
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=your-private-book-assets-bucket
ALLOWED_ORIGIN=http://localhost:3000

PHONEPE_CLIENT_ID="your-phonepe-client-id"
PHONEPE_CLIENT_SECRET="your-phonepe-client-secret"
PHONEPE_CLIENT_VERSION=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PUBLISHING_PAYMENT_REDIRECT_URL=http://localhost:3000/payment/callback?flow=publishing

PAYMENT_REDIRECT_URL=http://localhost:3000/payment/callback
# Production OAuth uses a separate identity endpoint; set from merchant configuration.
# PHONEPE_TOKEN_URL=https://api.phonepe.com/apis/identity-manager/v1/oauth/token

# Register /api/payments/phonepe/webhook with SHA authentication in PhonePe.
# Subscribe to checkout.order.completed, checkout.order.failed and pg.refund.completed.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Temporary publishing review fee waiver. Only "demo" bypasses collection.
# Switch to "live" when the payment integration is ready. Retail orders are unaffected.
REVIEW_PAYMENT_MODE=demo
